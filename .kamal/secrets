# Kamal reads these from the environment it's run in — never commit real
# values here. In CI (GitHub Actions), these are populated from repo secrets;
# locally, export them in your shell first.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
SUPABASE_URL=$SUPABASE_URL
SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=$SUPABASE_SERVICE_ROLE_KEY
ALLOWED_ORIGINS=$ALLOWED_ORIGINS

# Direct Postgres for the /api/* data layer (Phase 5, item 2).
# postgres://vastos_app:<pw>@vastos-api-postgres:5432/vastos
DATABASE_URL=$DATABASE_URL

# Accessories (Phase 4). Only needed for `kamal accessory` commands, not
# `kamal deploy`. Generate once with `openssl rand -hex 24`, then keep the
# values in your password manager + GitHub repo secrets.
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
MINIO_ROOT_PASSWORD=$MINIO_ROOT_PASSWORD

